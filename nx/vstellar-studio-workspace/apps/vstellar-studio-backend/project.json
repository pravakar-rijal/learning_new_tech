{
  "name": "vstellar-studio-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vstellar-studio-backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": [{"projects": ["vstellar-studio-frontend"], "target": "build"}],
      "executor": "nx-electron:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/vstellar-studio-backend",
        "main": "apps/vstellar-studio-backend/src/main.ts",
        "tsConfig": "apps/vstellar-studio-backend/tsconfig.app.json",
        "assets": ["apps/vstellar-studio-backend/src/assets"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/vstellar-studio-backend/src/environments/environment.ts",
              "with": "apps/vstellar-studio-backend/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run vstellar-studio-frontend:serve", "nx run vstellar-studio-backend:serve-vstellar-studio-backend"]
      }
    },
    "serve-vstellar-studio-backend": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "vstellar-studio-backend:build"
      }
    },
    "package": {
      "dependsOn": ["build"],
      "executor": "nx-electron:package",
      "options": {
        "name": "vstellar-studio-backend",
        "frontendProject": "vstellar-studio-frontend",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "vstellar-studio-backend",
        "frontendProject": "vstellar-studio-frontend",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "command": "eslint apps/vstellar-studio-backend/**/*.ts"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/vstellar-studio-backend/jest.config.ts"
      }
    }
  }
}
