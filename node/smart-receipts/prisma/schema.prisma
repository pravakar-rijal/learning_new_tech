generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(255)
  users User[]

  @@map("roles")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  googleProfileId   String?            @unique @map("google_profile_id") @db.VarChar(255)
  name              String             @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  password          String?            @db.VarChar(255)
  isActive          Boolean            @default(true) @map("is_active") @db.Boolean
  roleId            String?            @map("role_id") @db.Uuid
  role              Role?              @relation(fields: [roleId], references: [id])
  enable2Fa         Boolean?           @default(false) @map("enable_2fa") @db.Boolean
  secret2Fa         String?            @map("secret_2fa") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  payments          Payment[]
  groupMembers      GroupMember[]
  userRefreshTokens UserRefreshToken[]
  userInvalidTokens UserInvalidToken[]

  @@map("users")
}

model Bill {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  totalAmount Decimal   @default(0) @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active") @db.Boolean
  groupId     String    @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  createdBy   String?   @map("created_by") @db.VarChar(255)
  createdAt   DateTime? @map("created_at") @db.Timestamptz()
  updatedBy   String    @map("updated_by") @db.VarChar(255)
  updatedAt   DateTime  @updatedAt @map("updated_at")
  payments    Payment[]

  @@map("bills")
}

model Group {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  isActive     Boolean       @default(true) @map("is_active") @db.Boolean
  createdBy    String?       @map("created_by") @db.VarChar(255)
  createdAt    DateTime?     @map("created_at") @db.Timestamptz()
  updatedBy    String        @map("updated_by") @db.VarChar(255)
  updatedAt    DateTime      @updatedAt @map("updated_at")
  bills        Bill[]
  groupMembers GroupMember[]

  @@map("groups")
}

enum PaymentStatus {
  pending
  completed
  updated
  deleted
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  amountPaid Decimal       @map("amount_paid") @db.Decimal(10, 2)
  userId     String        @map("user_id") @db.Uuid
  user       User          @relation(fields: [userId], references: [id])
  billId     String        @map("bill_id") @db.Uuid
  bill       Bill          @relation(fields: [billId], references: [id])
  status     PaymentStatus @default(pending)
  createdBy  String?       @map("created_by") @db.VarChar(255)
  createdAt  DateTime?     @map("created_at") @db.Timestamptz()
  updatedBy  String        @map("updated_by") @db.VarChar(255)
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  isActive Boolean  @default(true) @map("is_active") @db.Boolean
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  groupId  String   @map("group_id") @db.Uuid
  group    Group    @relation(fields: [groupId], references: [id])
  joinedAt DateTime @default(now()) @map("joined_at") @db.Date

  @@map("group_members")
}

model UserRefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  token  String

  @@map("user_refresh_tokens")
}

model UserInvalidToken {
  id             String @id @default(uuid()) @db.Uuid
  accessToken    String @map("access_token") @db.Text
  userId         String @map("user_id") @db.Uuid
  user           User   @relation(fields: [userId], references: [id])
  expirationTime BigInt @map("expiration_time") @db.BigInt

  @@map("user_invalid_tokens")
}
